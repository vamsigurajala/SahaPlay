<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 450" width="300" height="450">
    <defs>
      <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#d0792a"/>
        <stop offset="100%" stop-color="#4a2208"/>
      </linearGradient>
      <linearGradient id="spine" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="rgba(0,0,0,0.5)"/>
        <stop offset="50%" stop-color="rgba(255,255,255,0.15)"/>
        <stop offset="100%" stop-color="transparent"/>
      </linearGradient>
    </defs>
    <rect width="300" height="450" rx="6" fill="url(#bg)"/>
    <rect x="18" y="18" width="264" height="414" rx="4" fill="none" stroke="rgba(255,215,120,0.5)" stroke-width="2"/>
    <rect x="24" y="24" width="252" height="402" rx="2" fill="none" stroke="rgba(255,215,120,0.25)" stroke-width="1"/>
    <rect width="20" height="450" fill="url(#spine)"/>
    <circle cx="150" cy="140" r="42" fill="none" stroke="#fff2d9" stroke-width="2" opacity="0.4"/>
    <text x="150" y="220" text-anchor="middle" font-family="Georgia, serif" font-size="22" font-weight="bold" fill="#fff2d9">Vikram and Betaal (retold)</text>
    <text x="150" y="260" text-anchor="middle" font-family="Georgia, serif" font-size="14" font-style="italic" fill="#fff2d9" opacity="0.85">Traditional tales</text>
    <path d="M 120 285 L 180 285" stroke="#fff2d9" stroke-width="1.5" opacity="0.4"/>
    <text x="150" y="380" text-anchor="middle" font-family="sans-serif" font-size="10" font-weight="bold" letter-spacing="3" text-transform="uppercase" fill="#fff2d9" opacity="0.6">INDIAN</text>
  </svg>