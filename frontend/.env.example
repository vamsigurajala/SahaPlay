# ─── Required ─────────────────────────────────────────────────────────────────

# Google OAuth client ID (same value as GOOGLE_CLIENT_ID in backend .env)
VITE_GOOGLE_CLIENT_ID=

# ─── Optional — cross-domain API (Render + Vercel split deployment) ───────────

# Backend API URL (leave blank for same-domain/LAN)
# For Render + Vercel split deployment, set to:
# https://your-backend.onrender.com
VITE_API_URL=

# Backend Socket.IO URL (usually same as API URL)
# Leave blank to use same value as VITE_API_URL
VITE_SOCKET_URL=

# ─── Optional — WebRTC TURN relay (camera + screen-share across different networks) ──

# Without a TURN server, camera/screen-share only works when both peers' NAT types
# allow a direct connection (e.g. same LAN, or lucky NAT combos). It silently fails
# — no error shown — for mobile data (CGNAT), symmetric NAT, and many corporate/hotel
# networks. All three must be set together or none are used (falls back to STUN-only).
# Get these from a TURN provider (e.g. Metered.ca, Twilio, Xirsys, or self-hosted coturn).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ─── Optional — error monitoring ───────────────────────────────────────────────

# Sentry DSN — leave unset to disable Sentry entirely (silent no-op in local dev)
VITE_SENTRY_DSN=https://your-key@sentry.io/project-id
