# ─── Required ─────────────────────────────────────────────────────────────────

# Google OAuth client ID (same value as GOOGLE_CLIENT_ID in backend .env)
VITE_GOOGLE_CLIENT_ID=

# ─── Optional — error monitoring ───────────────────────────────────────────────

# Sentry DSN — leave unset to disable Sentry entirely (silent no-op in local dev)
VITE_SENTRY_DSN=https://your-key@sentry.io/project-id
