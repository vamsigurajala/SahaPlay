      "browsePublicRooms": "ಸಾರ್ವಜನಿಕ ರೂಮ್‌ಗಳನ್ನು ನೋಡಿ",
      "heroMainDesc": "ಯೂಟ್ಯೂಬ್, ಟ್ವಿಚ್ ಮತ್ತು ಹೆಚ್ಚಿನವನ್ನು ಸ್ನೇಹಿತರೊಂದಿಗೆ ರಿಯಲ್-ಟೈಮ್‌ನಲ್ಲಿ ಸಮನ್ವಯಗೊಳಿಸಿ. ಲೈವ್ ಚಾಟ್, P2P ಸ್ಕ್ರೀನ್ ಶೇರಿಂಗ್ ಮತ್ತು ಪರಿಪೂರ್ಣ ಮೀಡಿಯಾ ಸಿಂಕ್ — 100% ಉಚಿತ.",
      "threeStepsSubtitle": "ಮೂರು ಹಂತಗಳು. ಅಷ್ಟೇ.",
      "threeStepsNoSignup": "ಅತಿಥಿಗಳಿಗೆ ಸೈನ್‌ಅಪ್ ಅಗತ್ಯವಿಲ್ಲ. ಡೌನ್‌ಲೋಡ್ ಇಲ್ಲ. ಪ್ಲಗಿನ್ ಇಲ್ಲ. ನೋಡಿ.",
      "step1HomeDesc": "ರೂಮ್ ರಚಿಸಿ ಕ್ಲಿಕ್ ಮಾಡಿ. ಒಂದು ಸೆಕೆಂಡಿನಲ್ಲಿ ವಿಶಿಷ್ಟ ಲಿಂಕ್‌ನೊಂದಿಗೆ ನಿಮ್ಮ ಖಾಸಗಿ ವೀಕ್ಷಣಾ ಸ್ಥಳ ಸಿದ್ಧ.",
      "step1HomeTag": "⚡ ತಕ್ಷಣ ಸಿದ್ಧ",
      "step2HomeDesc": "ನಿಮ್ಮ ರೂಮ್ ಲಿಂಕ್ ಹಂಚಿಕೊಳ್ಳಿ. ಸ್ನೇಹಿತರು ಒಂದು ಕ್ಲಿಕ್‌ನಲ್ಲಿ ಸೇರುತ್ತಾರೆ — ಖಾತೆ, ಆ್ಯಪ್, ತೊಂದರೆ ಇಲ್ಲ.",
      "step2HomeTag": "🔗 ಒಂದು ಕ್ಲಿಕ್‌ನಲ್ಲಿ ಸೇರಿ",
      "step3HomeDesc": "ಯಾವುದೇ ವೀಡಿಯೊ ಲಿಂಕ್ ಪೇಸ್ಟ್ ಮಾಡಿ ಅಥವಾ ಸ್ಕ್ರೀನ್ ಶೇರ್ ಮಾಡಿ. ಪ್ರತಿ ಪ್ಲೇ, ಪಾಸ್, ಸೀಕ್ ಎಲ್ಲರಿಗೆ ತಕ್ಷಣ ಸಮನ್ವಯಗೊಳ್ಳುತ್ತದೆ.",
      "step3HomeTag": "🎬 ಯಾವಾಗಲೂ ಸಿಂಕ್‌ನಲ್ಲಿ",
      "seeItInActionTitle": "ಇದನ್ನು ಕ್ರಿಯೆಯಲ್ಲಿ ನೋಡಿ",
      "seeItInActionDesc": "ರಿಯಲ್-ಟೈಮ್ ಚಾಟ್ ಜೀವಂತವಾಗಿ ಅನಿಸುತ್ತದೆ — ಪ್ರತಿಕ್ರಿಯೆಗಳು, ಮೀಡಿಯಾ, ಉತ್ತರಗಳು, ಎಲ್ಲವೂ ಸಿಂಕ್‌ನಲ್ಲಿ.",
      "privateChat": "ಖಾಸಗಿ ಚಾಟ್",
      "groupRoomChatTitle": "ಗ್ರೂಪ್ ರೂಮ್ ಚಾಟ್",
      "groupRoomChatDesc": "ರೂಮ್‌ನಲ್ಲಿರುವ ಎಲ್ಲರೂ ಇಮೋಜಿ ಪ್ರತಿಕ್ರಿಯೆಗಳು, ಉತ್ತರಗಳು ಮತ್ತು ಮೀಡಿಯಾ ಶೇರಿಂಗ್‌ನೊಂದಿಗೆ ರಿಯಲ್-ಟೈಮ್‌ನಲ್ಲಿ ಒಟ್ಟಿಗೆ ಚಾಟ್ ಮಾಡುತ್ತಾರೆ.",
      "privateEncryptedDMsTitle": "ಖಾಸಗಿ ಎನ್‌ಕ್ರಿಪ್ಟೆಡ್ DM",
      "privateEncryptedDMsDesc": "ರೂಮ್‌ನಲ್ಲಿ ಯಾರಿಗೇ ಆದರೂ ಖಾಸಗಿ ಸಂದೇಶ ಕಳುಹಿಸಿ. ಎಂಡ್-ಟು-ಎಂಡ್ ಎನ್‌ಕ್ರಿಪ್ಟೆಡ್ — ಬೇರೆ ಯಾರೂ ಓದಲು ಸಾಧ್ಯವಿಲ್ಲ.",
      "shareMediaFilesTitle": "ಮೀಡಿಯಾ & ಫೈಲ್‌ಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಿ",
      "shareMediaFilesDesc": "ರೂಮ್ ಬಿಡದೆ ನೇರವಾಗಿ ಚಾಟ್‌ನಲ್ಲಿ ಚಿತ್ರಗಳು, ವೀಡಿಯೊಗಳು ಮತ್ತು ಫೈಲ್‌ಗಳನ್ನು ಕಳುಹಿಸಿ.",
      "reactToMessagesTitle": "ಸಂದೇಶಗಳಿಗೆ ಪ್ರತಿಕ್ರಿಯಿಸಿ",
      "reactToMessagesDesc": "ಯಾವುದೇ ಸಂದೇಶದಲ್ಲಿ ಇಮೋಜಿ ಪ್ರತಿಕ್ರಿಯೆ. ಮಾತುಗಳನ್ನು ಮೀರಿ ನಿಮ್ಮನ್ನು ವ್ಯಕ್ತಪಡಿಸಿ.",
      "replyToMessagesTitle": "ಸಂದೇಶಗಳಿಗೆ ಉತ್ತರಿಸಿ",
      "replyToMessagesDesc": "ಸಂಭಾಷಣೆಯನ್ನು ಸ್ಪಷ್ಟವಾಗಿ ಇಡಲು ನಿರ್ದಿಷ್ಟ ಸಂದೇಶಗಳನ್ನು ಉಲ್ಲೇಖಿಸಿ ಉತ್ತರಿಸಿ.",
      "everythingYouNeedTitle": "ಒಟ್ಟಿಗೆ ನೋಡಲು ಅಗತ್ಯವಿರುವ ಎಲ್ಲವೂ.",
      "cuttingEdgeDesc": "ಅತ್ಯುತ್ತಮ ವೀಕ್ಷಣಾ ಅನುಭವಕ್ಕಾಗಿ ಅತ್ಯಾಧುನಿಕ ತಂತ್ರಜ್ಞಾನದಿಂದ ನಿರ್ಮಿಸಲಾಗಿದೆ.",
      "worksWithFavoritesTitle": "ನಿಮ್ಮ ಮೆಚ್ಚಿನವುಗಳೊಂದಿಗೆ ಕೆಲಸ ಮಾಡುತ್ತದೆ",
      "worksWithFavoritesDesc": "ಯಾವುದೇ ಲಿಂಕ್ ಪೇಸ್ಟ್ ಮಾಡಿ ನೋಡಲು ಆರಂಭಿಸಿ — ಹೆಚ್ಚುವರಿ ಸೆಟಪ್ ಇಲ್ಲ.",
      "faqSectionTitle": "ಪದೇ ಪದೇ ಕೇಳಲಾಗುವ ಪ್ರಶ್ನೆಗಳು",
      "faqSectionDesc": "ಪ್ರಾರಂಭಿಸುವ ಮೊದಲು ನೀವು ತಿಳಿದುಕೊಳ್ಳಬೇಕಾದದ್ದೆಲ್ಲ.",
      "homeFaqQ1": "ಸಹಾಪ್ಲೇ ಎಷ್ಟು ಭಾಷೆಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ?",
      "homeFaqA1": "SahaPlay ಪ್ರಸ್ತುತ 20 ಭಾಷೆಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತದೆ: ಇಂಗ್ಲಿಷ್, ಸ್ಪ್ಯಾನಿಷ್, ಫ್ರೆಂಚ್, ಜರ್ಮನ್, ಜಾಪನೀಸ್, ಕೊರಿಯನ್, ಚೈನೀಸ್, ಹಿಂದಿ, ಪೋರ್ಚುಗೀಸ್, ಅರಬಿಕ್, ರಷ್ಯನ್, ಇಟಾಲಿಯನ್, ತೆಲುಗು, ತಮಿಳು, ಬಂಗಾಳಿ, ಮರಾಠಿ, ಗುಜರಾತಿ, ಮಲಯಾಳಂ, ಕನ್ನಡ ಮತ್ತು ಪಂಜಾಬಿ. ಸೆಟ್ಟಿಂಗ್ಸ್ ಮೆನುವಿನಿಂದ ಯಾವಾಗ ಬೇಕಾದರೂ ನಿಮ್ಮ ಭಾಷೆ ಬದಲಾಯಿಸಬಹುದು.",
      "homeFaqQ2": "ರೂಮ್‌ನಲ್ಲಿ ಸ್ಟ್ರೀಮ್ ಮಾಡುವಾಗ ಇತರರ ವೀಡಿಯೊಗಳನ್ನು ಮರೆಮಾಡಬಹುದೇ?",
      "homeFaqA2": "ಹೌದು! ನೀವು ರೂಮ್‌ನಲ್ಲಿರುವಾಗ ಮತ್ತೊಬ್ಬ ಸದಸ್ಯ ಕ್ಯಾಮರಾ ಆನ್ ಮಾಡಿದ್ದರೆ, ಯಾವ ಸಮಯದಲ್ಲಾದರೂ ಅವರ ವೀಡಿಯೊ ಮರೆಮಾಡಬಹುದು ಅಥವಾ ತೋರಿಸಬಹುದು. ಅವರ ವೀಡಿಯೊ ಫೀಡ್ ಮೇಲೆ ಕ್ಲಿಕ್ ಮಾಡಿ ಮತ್ತು \"ವೀಡಿಯೊ ಮರೆಮಾಡಿ\" ಆಯ್ಕೆ ಮಾಡಿ. ಇದು ನಿಮ್ಮ ವೀಕ್ಷಣೆ ಮಾತ್ರ ಪರಿಣಾಮ ಬೀರುತ್ತದೆ — ಇತರರಿಗೆ ಅಲ್ಲ.",
      "homeFaqQ3": "ಸ್ನೇಹಿತರೊಂದಿಗೆ ನೆಟ್‌ಫ್ಲಿಕ್ಸ್ ಅಥವಾ ಪ್ರೈಮ್ ವೀಡಿಯೊ ನೋಡಬಹುದೇ?",
      "homeFaqA3": "ಹೌದು — ಸ್ಕ್ರೀನ್‌ಶೇರ್ ಫೀಚರ್ ಬಳಸಿ. ಹೋಸ್ಟ್ ತಮ್ಮ ನೆಟ್‌ಫ್ಲಿಕ್ಸ್ ಅಥವಾ ಪ್ರೈಮ್ ವೀಡಿಯೊ ಬ್ರೌಸರ್ ಟ್ಯಾಬ್ ಶೇರ್ ಮಾಡುತ್ತಾರೆ ಮತ್ತು ರೂಮ್‌ನಲ್ಲಿರುವ ಎಲ್ಲರೂ ರಿಯಲ್-ಟೈಮ್‌ನಲ್ಲಿ ನೋಡುತ್ತಾರೆ. ಸಬ್‌ಸ್ಕ್ರಿಪ್ಷನ್ ಅಗತ್ಯ ಹೋಸ್ಟ್‌ಗೆ ಮಾತ್ರ. ಸ್ಕ್ರೀನ್‌ಶೇರ್ ಕ್ರೋಮ್ ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಅತ್ಯುತ್ತಮವಾಗಿ ಕೆಲಸ ಮಾಡುತ್ತದೆ.",
      "homeFaqQ4": "ವಾಚ್ ಪಾರ್ಟಿ ಸಮಯದಲ್ಲಿ ಇಂಟರ್ನೆಟ್ ಕಡಿತವಾದರೆ ಏನಾಗುತ್ತದೆ?",
      "homeFaqA4": "SahaPlay ಸ್ವಯಂಚಾಲಿತವಾಗಿ ನಿಮ್ಮನ್ನು ರೂಮ್‌ಗೆ ಮರು-ಸಂಪರ್ಕಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ. ಮರಳಿ ಆನ್‌ಲೈನ್ ಆದ ನಂತರ, ವೀಡಿಯೊ ಪ್ರಸ್ತುತ ಎಲ್ಲಿ ಪ್ಲೇ ಆಗುತ್ತಿದೆ ಎಂಬಲ್ಲಿಗೆ ನೇರವಾಗಿ ಹೋಗುತ್ತದೆ — ನೀವು ಏನನ್ನೂ ಕಳೆದುಕೊಳ್ಳುವುದಿಲ್ಲ. ನಿಮ್ಮ ಚಾಟ್ ಇತಿಹಾಸ ಕೂಡ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮರು-ಲೋಡ್ ಆಗುತ್ತದೆ.",
      "roomCover": "ರೂಮ್ ಕವರ್",
      "chatLock": "ಚಾಟ್ ಲಾಕ್",
      "chatLockDesc": "ಎಂಡ್-ಟು-ಎಂಡ್ ಎನ್‌ಕ್ರಿಪ್ಟೆಡ್ ಚಾಟ್. ಸೆಶನ್-ಮಾತ್ರ ಕೀ ಮೆಟೀರಿಯಲ್. ನಿಜವಾದ ಗೋಪ್ಯತೆ.",
      "screenShare": "ಸ್ಕ್ರೀನ್ ಶೇರ್",
      "screenShareDesc": "P2P WebRTC ಸಂಪರ್ಕಗಳ ಮೂಲಕ ನೇರವಾಗಿ ಸ್ಕ್ರೀನ್ ಶೇರ್ ಮಾಡಿ.",
