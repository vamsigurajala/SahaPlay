      "security": "ಭದ್ರತೆ",
      "securityBannedUsers": "ಭದ್ರತಾ ನಿಷೇಧಿತ ಬಳಕೆದಾರರು",
      "securityLockoutActive": "Security lockout enabled",
      "securityTab": "ಭದ್ರತೆ",
      "selectChats": "ಚಾಟ್‌ಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ",
      "selectMedia": "ಮೀಡಿಯಾ ಆಯ್ಕೆಮಾಡಿ",
      "selected": "ಆಯ್ಕೆ ಮಾಡಲಾಗಿದೆ",
      "selfDestructDesc": "Too many failed attempts. For your security, all",
      "selfDestructDesc2": "are being permanently deleted.",
      "selfDestructTriggered": "FINAL ATTEMPT FAILED: LOCKED CHATS WIPED",
      "sendMessageToUser": "{{username}} ಗೆ ಸಂದೇಶ ಕಳುಹಿಸಿ",
      "sendResetCodeBtn": "Send Reset Code",
      "sending": "Sending…",
      "setLockPinBtn": "Set Lock PIN",
      "setPin": "Set 6-Digit PIN",
      "setupFailed": "Setup failed",
      "setupWatchPartyDesc": "Set up your watch party below",
      "sfBadge": "🛡️ ಸೇಫ್ಟಿ ಸೆಂಟರ್",
      "sfBlockUserDesc": "ಬ್ಲಾಕ್ ಮಾಡಲಾದ ಬಳಕೆದಾರರು ನಿಮಗೆ ಸಂದೇಶ ಕಳುಹಿಸಲು, ನಿಮ್ಮ ರೂಮ್‌ಗಳಿಗೆ ಸೇರಲು ಅಥವಾ ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ನೋಡಲು ಸಾಧ್ಯವಿಲ್ಲ.",
      "sfBlockUserLink": "ನಿಮ್ಮ ಬ್ಲಾಕ್ ಪಟ್ಟಿಗೆ ಹೋಗಿ →",
      "sfBlockUserStep1": "ಅವರ ಪ್ರೊಫೈಲ್‌ಗೆ ಹೋಗಿ",
      "sfBlockUserStep2": "⋮ ಮೆನು ಕ್ಲಿಕ್ ಮಾಡಿ",
      "sfBlockUserStep3": "\"ಬಳಕೆದಾರರನ್ನು ಬ್ಲಾಕ್ ಮಾಡಿ\" ಆಯ್ಕೆಮಾಡಿ",
      "sfBlockUserTitle": "ಬಳಕೆದಾರರನ್ನು ಬ್ಲಾಕ್ ಮಾಡಿ",
      "sfContactSupportDesc": "ಇಲ್ಲಿ ಪಟ್ಟಿ ಮಾಡದ ಸಮಸ್ಯೆಗಳಿಗೆ ಸಹಾಯ ಬೇಕೇ?",
      "sfContactSupportLink": "ನಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಿ →",
      "sfContactSupportTitle": "ಬೆಂಬಲವನ್ನು ಸಂಪರ್ಕಿಸಿ",
      "sfHelpBadgeConfidential": "ರಹಸ್ಯವಾಗಿಡಲಾಗುತ್ತದೆ",
      "sfHelpBadgePersonal": "ವೈಯಕ್ತಿಕವಾಗಿ ಪರಿಶೀಲಿಸಲಾಗುತ್ತದೆ",
      "sfHelpBadgeResponse": "48 ಗಂಟೆಗಳ ಪ್ರತಿಕ್ರಿಯೆ",
      "sfHelpContactBtn": "ಸುರಕ್ಷತಾ ತಂಡವನ್ನು ಸಂಪರ್ಕಿಸಿ →",
      "sfHelpDesc": "ನೀವು ಕಿರುಕುಳವನ್ನು ಎದುರಿಸುತ್ತಿದ್ದರೆ ಅಥವಾ ಅಸುರಕ್ಷಿತರಾಗಿದ್ದರೆ, ನಾವು ಸಹಾಯ ಮಾಡಲು ಇಲ್ಲಿದ್ದೇವೆ. ಎಲ್ಲಾ ವರದಿಗಳನ್ನು ವೈಯಕ್ತಿಕವಾಗಿ ಪರಿಶೀಲಿಸಲಾಗುತ್ತದೆ.",
      "sfHelpRulesBtn": "ನಿಯಮಗಳನ್ನು ವೀಕ್ಷಿಸಿ",
      "sfHelpTitle": "ಸುರಕ್ಷತಾ ಸಹಾಯ ಬೇಕೇ?",
      "sfHeroPill1": "🔒 ಎಂಡ್-ಟು-ಎಂಡ್ ಎನ್ಕ್ರಿಪ್ಟ್ ಚಾಟ್ಸ್",
      "sfHeroPill2": "🚫 ಕಿರುಕುಳದ ವಿರುದ್ಧ ಕಠಿಣ ಕ್ರಮಗಳು",
      "sfHeroPill3": "⚡ 48 ಗಂಟೆಗಳಲ್ಲಿ ವರದಿಗಳ ಪರಿಶೀಲನೆ",
      "sfLockAttemptsBullet1": "ಬಳಕೆದಾರರಿಗೆ 2 ಪಿನ್ ಪ್ರಯತ್ನಗಳು ಸಿಗುತ್ತವೆ.",
      "sfLockAttemptsBullet2": "2 ಬಾರಿ ತಪ್ಪು ಪಿನ್ ನಮೂದಿಸಿದ ನಂತರ, 30 ಸೆಕೆಂಡ್‌ಗಳ ಸೆಕ್ಯೂರಿಟಿ ಲಾಕೌಟ್ ಟೈಮರ್ ಕಾಣಿಸುತ್ತದೆ.",
      "sfLockAttemptsBullet3": "ಲಾಕೌಟ್ ಸಮಯದಲ್ಲಿ, ಪಿನ್ ನಮೂದು ತಾತ್ಕಾಲಿಕವಾಗಿ ಸ್ಥಗಿತಗೊಳ್ಳುತ್ತದೆ.",
      "sfLockAttemptsBullet4": "ಟೈಮರ್ ಮುಗಿದ ನಂತರ, ನೀವು ಪಿನ್ ಅನ್ನು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಬಹುದು ಅಥವಾ ಕೊನೆಯ ಪ್ರಯತ್ನಕ್ಕಾಗಿ ಮಾಸ್ಟರ್ ಕೀಲಿಯನ್ನು ಬಳಸಬಹುದು.",
      "sfLockAttemptsTitle": "ಪಿನ್ ಪ್ರಯತ್ನಗಳು & ಲಾಕೌಟ್ ವಿವರಗಳು:",
      "sfLockChatsDesc": "ಹೆಚ್ಚುವರಿ ಗೌಪ್ಯತೆಗಾಗಿ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಚಾಟ್‌ಗಳಿಗೆ 6-ಅಂಕಿಯ ಪಿನ್ ಸೇರಿಸಿ. ಲಾಕ್ ಮಾಡಲಾದ ಚಾಟ್‌ಗಳು ಮರೆಯಾಗುತ್ತವೆ",
      "sfLockChatsLink": "ಚಾಟ್ ಲಾಕ್ ಬಗ್ಗೆ ತಿಳಿಯಿರಿ →",
      "sfLockChatsStep1": "ಯಾವುದೇ ಚಾಟ್ ತೆರೆಯಿರಿ",
      "sfLockChatsStep2": "⋮ ಮೆನುವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ",
      "sfLockChatsStep3": "ಚಾಟ್ ಲಾಕ್ ಆಯ್ಕೆಮಾಡಿ.",
      "sfLockChatsTitle": "ನಿಮ್ಮ ಚಾಟ್‌ಗಳನ್ನು ಲಾಕ್ ಮಾಡಿ",
      "sfLockModalButton": "ಅರ್ಥವಾಯಿತು ✓",
      "sfLockModalSubtitle": "6-ಅಂಕಿಯ ಪಿನ್‌ನೊಂದಿಗೆ ವೈಯಕ್ತಿಕ ಸಂಭಾಷಣೆಗಳನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸಿ.",
      "sfLockModalTitle": "ಚಾಟ್ ಲಾಕ್",
      "sfLockSec1Step1": "ಮೇಲಿನ ನ್ಯಾವಿಗೇಶನ್‌ನಲ್ಲಿರುವ ಚಾಟ್ ಐಕಾನ್‌ನಿಂದ ಸಂಭಾಷಣೆಗಳ ವಿಂಡೋವನ್ನು ತೆರೆಯಿರಿ.",
      "sfLockSec1Step2": "ನೀವು ಲಾಕ್ ಮಾಡಲು ಬಯಸುವ ಚಾಟ್‌ನಲ್ಲಿ ಬಲಭಾಗದಲ್ಲಿರುವ ಡ್ರಾಪ್‌ಡೌನ್ ಬಾಣ ಅಥವಾ ಮೂರು ಚುಕ್ಕೆಗಳ ಮೆನುವನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ.",
      "sfLockSec1Step3": "\"ಚಾಟ್‌ ಲಾಕ್ ಮಾಡಿ\" ಆಯ್ಕೆಮಾಡಿ.",
      "sfLockSec1Step4": "ಇದು ನಿಮ್ಮ ಮೊದಲ ಬಾರಿಯಾಗಿದ್ದರೆ, 6-ಅಂಕಿಯ ಪಿನ್ ರಚಿಸಲು ಕೇಳಲಾಗುತ್ತದೆ.",
      "sfLockSec1Step5": "ಪಿನ್ ಸೆಟ್ ಮಾಡಿದ ನಂತರ, ಆಪ್ ಒಂದು ಮಾಸ್ಟರ್ ಕೀಲಿಯನ್ನು (Master Key) ಸೃಷ್ಟಿಸುತ್ತದೆ.",
      "sfLockSec1Step6": "ಮಾಸ್ಟರ್ ಕೀಲಿಯನ್ನು ಸುರಕ್ಷಿತ ಸ್ಥಳದಲ್ಲಿ ಭದ್ರಪಡಿಸಿ. ನೀವು ಪಿನ್ ಮರೆತರೆ ಇದು ಅಗತ್ಯವಿರುತ್ತದೆ.",
      "sfLockSec1Step7": "ಲಾಕ್ ಮಾಡಿದ ನಂತರ, ಚಾಟ್ ಲಾಕ್ ಮಾಡಲಾದ ಚಾಟ್‌ಗಳ ಫೋಲ್ಡರ್‌ಗೆ ಹೋಗುತ್ತದೆ.",
      "sfLockSec1Title": "ಚಾಟ್‌ ಅನ್ನು ಹೇಗೆ ಲಾಕ್ ಮಾಡುವುದು",
      "sfLockSec2Step1": "ಸಂಭಾಷಣೆಗಳ ವಿಂಡೋವನ್ನು ತೆರೆಯಿರಿ.",
      "sfLockSec2Step2": "ಮೇಲಿನ ಬಲಭಾಗದಲ್ಲಿರುವ ಮೂರು ಚುಕ್ಕೆಗಳ ಮೆನುವನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ.",
      "sfLockSec2Step3": "\"ಲಾಕ್ ಮಾಡಿದ ಚಾಟ್‌ಗಳು\" ಆಯ್ಕೆಮಾಡಿ.",
      "sfLockSec2Step4": "ನಿಮ್ಮ 6-ಅಂಕಿಯ ಪಿನ್ ಅನ್ನು ನಮೂದಿಸಿ.",
      "sfLockSec2Step5": "ಅನ್‌ಲಾಕ್ ಮಾಡಿದ ನಂತರ, ನೀವು ಲಾಕ್ ಮಾಡಿದ ಚಾಟ್‌ಗಳ ಫೋಲ್ಡರ್ ಒಳಗೆ ಎಲ್ಲಾ ಚಾಟ್‌ಗಳನ್ನು ನೋಡಬಹುದು.",
      "sfLockSec2Title": "ಲಾಕ್ ಮಾಡಿದ ಚಾಟ್‌ಗಳನ್ನು ಹೇಗೆ ತೆರೆಯುವುದು",
      "sfLockSec3Desc1": "ನೀವು ಅನ್‌ಲಾಕ್ ಮಾಡಿದ ನಂತರ ಲಾಕ್ ಮಾಡಿದ ಚಾಟ್ ಎಷ್ಟು ಸಮಯ ತೆರೆದಿರಬೇಕೆಂದು ಆಟೋ-ಲಾಕ್ ನಿಯಂತ್ರಿಸುತ್ತದೆ.",
      "sfLockSec3Desc2": "ಲಭ್ಯವಿರುವ ಆಯ್ಕೆಗಳು: ತಕ್ಷಣವೇ · 1 ನಿಮಿಷ · 5 ನಿಮಿಷಗಳು · 15 ನಿಮಿಷಗಳು · ಎప్పటికీ ಬೇಡ",
      "sfLockSec3Desc3": "ಆಯ್ಕೆ ಮಾಡಿದ ಸಮಯ ಮುಗಿದ ನಂತರ, ಚಾಟ್ ಆಟೋಮ್ಯಾಟಿಕ್ ಆಗಿ ಮತ್ತೆ ಲಾಕ್ ಆಗುತ್ತದೆ. ಮತ್ತೆ ತೆರೆಯಲು, ನೀವು ಪಿನ್ ಅನ್ನು ಮತ್ತೆ ನಮೂದಿಸಬೇಕು.",
      "sfLockSec3Path": "ಸೆಟ್ಟಿಂಗ್ಸ್ → ಲಾಕ್ ಮಾಡಿದ ಚಾಟ್‌ಗಳು → ಚಾಟ್ ಲಾಕ್ ಸೆಟ್ಟಿಂಗ್ಸ್ → ಆಟೋ-ಲಾಕ್ ಟೈಮರ್",
      "sfLockSec3Title": "ಆಟೋ-ಲಾಕ್ ವೈಶಿಷ್ಟ್ಯ",
      "sfLockSec4Desc1": "ನೀವು ರೂಮ್ ಒಳಗಿನಿಂದ ಅಥವಾ ಸಂಭಾಷಣೆಗಳ ವಿಂಡೋದಿಂದ ವೈಯಕ್ತಿಕ ಚಾಟ್ ಲಾಕ್ ಮಾಡಿದರೆ, ಅದು ಸಂಪೂರ್ಣವಾಗಿ ಮಾಯವಾಗುವುದಿಲ್ಲ.",
      "sfLockSec4Desc2": "ವೈಯಕ್ತಿಕ ಚಾಟ್ ರೂಮ್ ಅಥವಾ ಚಾಟ್ ಪಟ್ಟಿಯಲ್ಲಿ ಕಾಣಿಸುತ್ತದೆ, ಆದರೆ ಬಲಭಾಗದಲ್ಲಿ ಒಂದು ಬೀಗದ ಗುರುತನ್ನು ತೋರಿಸುತ್ತದೆ.",
      "sfLockSec4Desc3": "ಆ ಲಾಕ್ ಮಾಡಿದ ವೈಯಕ್ತಿಕ ಚಾಟ್ ತೆರೆಯಲು, ನೀವು ಪಿನ್ ನಮೂದಿಸಬೇಕು.",
      "sfLockSec4Desc4": "ರೂಮ್‌ನ ಗ್ರೂಪ್ ಚಾಟ್ ರೂಮ್ ಸದಸ್ಯರೆಲ್ಲರಿಗೂ ಕಾಣಿಸುತ್ತದೆ. ಚಾಟ್ ಲಾಕ್ ಲಾಕ್ ಮಾಡಿದ ಸಂಭಾಷಣೆಗಳಿಗೆ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಪ್ರವೇಶವನ್ನು ಮಾತ್ರ ರಕ್ಷಿಸುತ್ತದೆ.",
      "sfLockSec4Title": "ರೂಮ್‌ಗಳ ಒಳಗೆ ಚಾಟ್ ಲಾಕ್",
      "sfLockSec5Step1": "ಲಾಕ್ ಮಾಡಿದ ಚಾಟ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ.",
      "sfLockSec5Step2": "ಚಾಟ್ ಲಾಕ್ ಸೆಟ್ಟಿಂಗ್ಸ್‌ಗೆ ಹೋಗಿ.",
      "sfLockSec5Step3": "ಚಾಟ್ ಲಾಕ್ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ ಆಯ್ಕೆಮಾಡಿ.",
      "sfLockSec5Step4": "ದೃಢೀಕರಿಸಲು ನಿಮ್ಮ ಪಿನ್ ಅನ್ನು ನಮೂದಿಸಿ.",
      "sfLockSec5Step5": "ಲಾಕ್ ಮಾಡಿದ ಚಾಟ್‌ಗಳು ಮತ್ತೆ ಸಾಮಾನ್ಯ ಚಾಟ್‌ಗಳಾಗುತ್ತವೆ.",
      "sfLockSec5Title": "ಚಾಟ್ ಲಾಕ್ ಅನ್ನು ಹೇಗೆ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುವುದು",
      "sfLockSec6Badge": "ಯಾವಾಗಲೂ ನಿಮ್ಮ ಮಾಸ್ಟರ್ ಕೀಲಿಯನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸಿ",
      "sfLockSec6Desc1": "ನೀವು ನಿಮ್ಮ ಪಿನ್ ಮರೆತರೆ, ಆಕ್ಸೆಸ್ ಮರಳಿ ಪಡೆಯಲು ನಿಮ್ಮ ಮಾಸ್ಟರ್ ಕೀಲಿಯನ್ನು ಬಳಸಬಹುದು.",
      "sfLockSec6Desc2": "ಮಾಸ್ಟರ್ ಕೀ ಸರಿಯಾಗಿದ್ದರೆ, ಲಾಕ್ ಮಾಡಿದ ಚಾಟ್‌ಗಳು ತೆರೆಯಲ್ಪಡುತ್ತವೆ ಮತ್ತು ಬಳಕೆದಾರ ಪಿನ್ ಅನ್ನು ರಿಸೆಟ್ ಮಾಡಬಹುದು.",
      "sfLockSec6Desc3": "ಪಿನ್ ಮತ್ತು ಮಾಸ್ಟರ್ ಕೀ ಎರಡನ್ನೂ ಮರೆತರೆ, ಲಾಕ್ ಮಾಡಿದ ಚಾಟ್ ಡೇಟಾವನ್ನು ಮರಳಿ ಪಡೆಯಲು ಸಾಧ್ಯವಿಲ್ಲ ಮತ್ತು ವಾಲ್ಟ್ ಅನ್‌ಲಾಕ್ ಮಾಡಲು ಡೇಟಾವನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಬೇಕಾಗುತ್ತದೆ.",
      "sfLockSec6Example": "ಉದಾಹರಣೆ:",
      "sfLockSec6Format": "ಮಾಸ್ಟರ್ ಕೀ ಫಾರ್ಮ್ಯಾಟ್:",
      "sfLockSec6Sub": "(ಹೈಫನ್‌ಗಳನ್ನು ಹೊರತುಪಡಿಸಿ ಒಟ್ಟು 32 ಹೆಕ್ಸಾಡೆಸಿಮಲ್ ಅಕ್ಷರಗಳನ್ನು ಹೊಂದಿರುತ್ತದೆ)",
      "sfLockSec6Title": "ಪ್ರಮುಖ ರಿಕವರಿ ಎಚ್ಚರಿಕೆ",
      "sfPrivacyCard1Desc": "ವೈಯಕ್ತಿಕ ಚಾಟ್‌ಗಳು ಎಂಡ್-ತು-ಎಂಡ್ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಆಗಿವೆ. ಯಾರೂ — ಕೊನೆಗೆ ನಾವು ಸಹ — ನಿಮ್ಮ ಸಂದೇಶಗಳನ್ನು ಓದಲು ಸಾಧ್ಯವಿಲ್ಲ.",
      "sfPrivacyCard1Title": "🔐 ಎನ್ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಸಂದೇಶಗಳು",
      "sfPrivacyCard2Desc": "ನಾವು ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಎಂದಿಗೂ ಮಾರಾಟ ಮಾಡುವುದಿಲ್ಲ ಅಥವಾ ಜಾಹೀರಾತುದಾರರೊಂದಿಗೆ ನಿಮ್ಮ ಚಟುವಟಿಕೆಯನ್ನು ಹಂಚಿಕೊಳ್ಳುವುದಿಲ್ಲ. ನಿಮ್ಮ ಮಾಹಿತಿ ನಿಮ್ಮದೇ.",
      "sfPrivacyCard2Title": "🚫 ಡೇಟಾ ಮಾರಾಟವಿಲ್ಲ",
      "sfPrivacyCard3Desc": "ಸೆಟ್ಟಿಂಗ್ಸ್‌ನಿಂದ ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ಸಂದೇಶಗಳನ್ನು ಅಳಿಸಿ, ಚಾಟ್ ಇತಿಹಾಸವನ್ನು ಕ್ಲಿಯರ್ ಮಾಡಿ ಅಥವಾ ನಿಮ್ಮ ಖಾತೆಯನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಅಳಿಸಿ.",
      "sfPrivacyCard3Title": "🗑️ ನಿಯಂತ್ರಣ ನಿಮ್ಮ ಕೈಯಲ್ಲಿದೆ",
      "sfPrivacyTitle": "ಗೌಪ್ಯತೆಯನ್ನು ಗಮನದಲ್ಲಿಟ್ಟುಕೊಂಡು ನಿರ್ಮಿಸಲಾಗಿದೆ",
      "sfQuickActionsSubtitle": "ನಿಮಗೆ ಬೇಕಾದ ಎಲ್ಲವನ್ನೂ ಆಪ್‌ನಲ್ಲಿಯೇ ನಿರ್ಮಿಸಲಾಗಿದೆ",
      "sfQuickActionsTitle": "ತ್ವರಿತ ಸುರಕ್ಷತಾ ಕ್ರಮಗಳು",
      "sfRepModalBody1": "ಯಾವುದೇ ರೂಮ್‌ನಲ್ಲಿ, ಅನುಚಿತ ಅಥವಾ ಅಸಭ್ಯ ಸಂದೇಶದ ಕೆಳಗೆ ಕಾಣಿಸುವ ವರದಿ ಮಾಡು ಬಟನ್ ಒತ್ತಿ. ಇದು ಚಾಟ್‌ನಿಂದ ನೇರವಾಗಿ ಆ ಸಂದೇಶ ಅಥವಾ ಬಳಕೆದಾರರನ್ನು ವರದಿ ಮಾಡಲು ಅನುಮತಿಸುತ್ತದೆ.",
      "sfRepModalBody2": "ರೂಮ್ ಅಥವಾ ಚಾಟ್‌ನಲ್ಲಿ ಎಲ್ಲಿಯಾದರೂ ಅವರ ಬಳಕೆದಾರರ ಹೆಸರನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ — ನಿಮ್ಮನ್ನು ಅವರ ಪ್ರೊಫೈಲ್‌ಗೆ ಕರೆದೊಯ್ಯಲಾಗುತ್ತದೆ. ಮೇಲಿನ ಬಲಭಾಗದಲ್ಲಿರುವ ⋮ ಮೂರು ಚುಕ್ಕೆಗಳ ಮೆನುವನ್ನು ಒತ್ತಿ, ವರದಿ ಮಾಡು ಎಂಬುದನ್ನು ಆಯ್ಕೆ ಮಾಡಿ.",
      "sfRepModalButton": "ಅರ್ಥವಾಯಿತು ✓",
      "sfRepModalHeader1": "ಗ್ರೂಪ್ ಚಾಟ್‌ನಿಂದ",
      "sfRepModalHeader2": "ಅವರ ಪ್ರೊಫೈಲ್‌ನಿಂದ",
      "sfRepModalSubtitle": "SahaPlay ನಲ್ಲಿ ಬಳಕೆದಾರರನ್ನು ವರದಿ ಮಾಡಲು ಎರಡು ಮಾರ್ಗಗಳು",
      "sfRepModalTitle": "ಯಾರನ್ನಾದರೂ ವರದಿ ಮಾಡುವುದು ಹೇಗೆ",
      "sfReportBanner": "⚡ ನಾವು ಎಲ್ಲಾ ಸೇಫ್ಟಿ ವರದಿಗಳಿಗೆ 48 ಗಂಟೆಗಳಲ್ಲಿ ಸ್ಪಂದಿಸುವ ಗುರಿ ಹೊಂದಿದ್ದೇವೆ. ತುರ್ತು ವರದಿಗಳಿಗೆ ಆದ್ಯತೆ ನೀಡಲಾಗುತ್ತದೆ.",
      "sfReportBugDesc": "ಆಪ್‌ನಲ್ಲಿ ಏನಾದರೂ ಮುರಿದಿದೆಯೇ ಅಥವಾ ವಿಚಿತ್ರವಾಗಿ ವರ್ತಿಸುತ್ತಿದೆಯೇ?",
      "sfReportBugLink": "ಬಗ್ ವರದಿ ಮಾಡಿ →",
      "sfReportBugTitle": "ಬಗ್ ವರದಿ ಮಾಡಿ",
      "sfReportStep1Desc": "ನೀವು ಗ್ರೂಪ್ ಚಾಟ್‌ನಿಂದ ಅಥವಾ ನೇರವಾಗಿ ಅವರ ಪ್ರೊಫೈಲ್‌ನಿಂದ ವರದಿ ಮಾಡಬಹುದು.",
      "sfReportStep1Link": "ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ →",
      "sfReportStep1Title": "ರೂಮ್‌ನಲ್ಲಿ",
      "sfReportStep2Desc": "ಬಳಕೆದಾರರ ಹೆಸರು, ರೂಮ್ ಐಡಿ ಮತ್ತು ಏನು ಸಂಭವಿಸಿದೆ ಎಂಬುದನ್ನು ವಿವರಿಸುತ್ತಾ safety@sahaplay.com ಗೆ ಇಮೇಲ್ ಮಾಡಿ.",
      "sfReportStep2Title": "ಇಮೇಲ್ ಮೂಲಕ",
      "sfReportStep3Desc": "ನಾವು ಪ್ರತಿ ವರದಿಯನ್ನು 48 ಗಂಟೆಗಳಲ್ಲಿ ಪರಿಶೀಲಿಸುತ್ತೇವೆ. ದೃಢೀಕರಿಸಲ್ಪಟ್ಟ ಉಲ್ಲಂಘನೆಗಳ ಫಲಿತಾಂಶವಾಗಿ ಎಚ್ಚರಿಕೆಗಳು, ನಿಷೇಧಗಳು ಅಥವಾ ತೆಗೆದುಹಾಕುವಿಕೆ ಇರುತ್ತವೆ.",
      "sfReportStep3Title": "ನಾವು ಕ್ರಮ ಕೈಗೊಳ್ಳುತ್ತೇವೆ",
      "sfReportSubtitle": "ಯಾರಾದರೂ ನಿಮ್ಮ ಅನುಭವವನ್ನು ಅಸುರಕ್ಷಿತಗೊಳಿಸುತ್ತಿದ್ದರೆ, ಇಲ್ಲಿ ನಿಖರವಾಗಿ ಏನು ಮಾಡಬೇಕೆಂದು ವಿವರಿಸಲಾಗಿದೆ.",
      "sfReportTitle": "ಯಾರನ್ನಾದರೂ ವರದಿ ಮಾಡುವುದು ಹೇಗೆ",
      "sfRulesEncouraged": "✅ ಪ್ರೋತ್ಸಾಹಿಸಲಾದವುಗಳು",
      "sfRulesEncouraged1": "ಸ್ನೇಹಿತರೊಂದಿಗೆ ಸೇರಿ ವಿಡಿಯೋಗಳನ್ನು ವೀಕ್ಷಿಸುವುದು",
      "sfRulesEncouraged2": "ವಾಚ್ ಪಾರ್ಟಿಗಳ ಸಮಯದಲ್ಲಿ ಸ್ನೇಹಪರ ಚಾಟ್",
      "sfRulesEncouraged3": "ನಿಮ್ಮ ಸಮುದಾಯದೊಂದಿಗೆ ರೂಮ್‌ಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳುವುದು",
      "sfRulesEncouraged4": "ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನಿಂದ ಸ್ಥಳೀಯ ಫೈಲ್‌ಗಳನ್ನು ಪ್ಲೇ ಮಾಡುವುದು",
      "sfRulesEncouraged5": "ನಿಮ್ಮ ಸ್ವಂತ ವಿಷಯವನ್ನು ಸ್ಕ್ರೀನ್ ಶೇರ್ ಮಾಡುವುದು",
      "sfRulesEncouraged6": "ರೂಮ್‌ಗಳ ನಿರ್ವಹಣೆಗೆ ಹೋಸ್ಟ್ ಕಂಟ್ರೋಲ್ಸ್ ಬಳಸುವುದು",
      "sfRulesEncouraged7": "ಆಪ್ ಅನ್ನು ಸುಧಾರಿಸಲು ಸಮಸ್ಯೆಗಳನ್ನು ವರದಿ ಮಾಡುವುದು",
      "sfRulesNotAllowed": "❌ ಅನುಮತಿಸದವುಗಳು",
      "sfRulesNotAllowed1": "ಯಾವುದೇ ಬಳಕೆದಾರರನ್ನು ಪೀಡಿಸುವುದು ಅಥವಾ ಬೆದರಿಸುವುದು",
      "sfRulesNotAllowed2": "ಕಾನೂನುಬಾಹಿರ ಅಥವಾ ಪೈರೇಟೆಡ್ ವಿಷಯವನ್ನು ಹಂಚಿಕೊಳ್ಳುವುದು",
      "sfRulesNotAllowed3": "ರೂಮ್‌ಗಳಲ್ಲಿ ವಯಸ್ಕರ ಅಥವಾ ಅಸಭ್ಯ ವಿಷಯ ಪ್ರದರ್ಶನ",
      "sfRulesNotAllowed4": "ದ್ವೇಷಪೂರಿತ ಭಾಷಣ ಅಥವಾ ತಾರತಮ್ಯ",
      "sfRulesNotAllowed5": "ಲಿಂಕ್‌ಗಳು ಅಥವಾ ಸಂದೇಶಗಳನ್ನು ಸ್ಪ್ಯಾಮ್ ಮಾಡುವುದು",
      "sfRulesNotAllowed6": "ಇತರ ಬಳಕೆದಾರರಂತೆ ನಟಿಸುವುದು",
      "sfRulesNotAllowed7": "ಆಪ್ ಅನ್ನು ಹ್ಯಾಕ್ ಮಾಡಲು ಅಥವಾ ದುರುಪಯೋಗಪಡಿಸಿಕೊಳ್ಳಲು ಪ್ರಯತ್ನಿಸುವುದು",
      "sfRulesNotAllowed8": "ಇತರರ ಬಗ್ಗೆ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಹಂಚಿಕೊಳ್ಳುವುದು",
      "sfRulesSubtitle": "ಸಹಾಪ್ಲೇಯನ್ನು ಎಲ್ಲರಿಗೂ ಮೋಜಿನ ಮತ್ತು ಸುರಕ್ಷಿತವಾಗಿಡಲು, ಈ ನಿಯಮಗಳು ಎಲ್ಲಾ ಬಳಕೆದಾರರಿಗೆ ಅನ್ವಯಿಸುತ್ತವೆ.",
      "sfRulesTitle": "ಸಾಮುದಾಯಿಕ ನಿಯಮಗಳು",
      "sfRulesWarning": "⚠️ ತೀವ್ರತೆಯನ್ನು ಅವಲಂಬಿಸಿ ರೂಮ್‌ಗಳಿಂದ ತಕ್ಷಣವೇ ತೆಗೆದುಹಾಕುವುದು, ತಾತ್ಕಾಲಿಕ ಅಮಾನತು ಅಥವಾ ಶಾಶ್ವತ ನಿಷೇಧಕ್ಕೆ ಕಾರಣವಾಗಬಹುದು.",
      "sfStepsHeader": "ಮಾಡುವ ವಿಧಾನ:",
      "sfSubtitle": "ಸಹಾಪ್ಲೇ ಮನರಂಜನೆ ಮತ್ತು ಕನೆಕ್ಟಿವಿಟಿಗಾಗಿ ನಿರ್ಮಿಸಲಾಗಿದೆ. ನೀವು ಸುರಕ್ಷಿತವಾಗಿರಲು, ಸಮಸ್ಯೆಗಳನ್ನು ವರದಿ ಮಾಡಲು ಮತ್ತು ನಿಮ್ಮ ಅನುಭವವನ್ನು ಆನಂದಿಸಲು ಅಗತ್ಯವಿರುವ ಎಲ್ಲವೂ ಇಲ್ಲಿದೆ.",
      "sfTitlePart1": "ನಿಮ್ಮ ಸುರಕ್ಷತೆ",
