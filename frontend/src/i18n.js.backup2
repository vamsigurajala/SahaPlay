      "shareMediaFilesDesc": "रूम छोड़े बिना सीधे चैट में इमेज, वीडियो और फाइलें भेजें।",
      "reactToMessagesTitle": "मैसेज पर रिएक्ट करें",
      "reactToMessagesDesc": "किसी भी मैसेज पर इमोजी रिएक्शन। शब्दों से परे खुद को व्यक्त करें।",
      "replyToMessagesTitle": "मैसेज का जवाब दें",
      "replyToMessagesDesc": "बातचीत को स्पष्ट रखने के लिए विशिष्ट मैसेज को कोट करके जवाब दें।",
      "everythingYouNeedTitle": "साथ में देखने के लिए सब कुछ।",
      "cuttingEdgeDesc": "सर्वश्रेष्ठ देखने के अनुभव के लिए अत्याधुनिक तकनीक से निर्मित।",
      "worksWithFavoritesTitle": "आपके पसंदीदा के साथ काम करता है",
      "worksWithFavoritesDesc": "कोई भी लिंक पेस्ट करें और देखना शुरू करें — कोई अतिरिक्त सेटअप नहीं।",
      "faqSectionTitle": "अक्सर पूछे जाने वाले सवाल",
      "faqSectionDesc": "शुरू करने से पहले जो कुछ भी जानना जरूरी है।",
      "homeFaqQ1": "सहाप्ले कितनी भाषाओं को सपोर्ट करता है?",
      "homeFaqA1": "SahaPlay वर्तमान में 20 भाषाओं को सपोर्ट करता है: अंग्रेजी, स्पेनिश, फ्रेंच, जर्मन, जापानी, कोरियाई, चीनी, हिंदी, पुर्तगाली, अरबी, रूसी, इतालवी, तेलुगु, तमिल, बंगाली, मराठी, गुजराती, मलयालम, कन्नड़ और पंजाबी। आप सेटिंग्स मेनू से कभी भी अपनी भाषा बदल सकते हैं।",
      "homeFaqQ2": "क्या मैं रूम में स्ट्रीमिंग के दौरान दूसरों के वीडियो छुपा सकता हूं?",
      "homeFaqA2": "हां! जब आप रूम में हों और कोई अन्य मेंबर कैमरा चालू रखे हो, तो आप किसी भी समय उनका वीडियो छुपा या दिखा सकते हैं। बस उनके वीडियो फीड पर क्लिक करें और \"वीडियो छुपाएं\" चुनें। यह केवल आपके व्यू को प्रभावित करता है — बाकी लोगों पर कोई असर नहीं।",
      "homeFaqQ3": "क्या मैं दोस्तों के साथ नेटफ्लिक्स या प्राइम वीडियो देख सकता हूं?",
      "homeFaqA3": "हां — स्क्रीनशेयर फीचर का उपयोग करके। होस्ट अपना नेटफ्लिक्स या प्राइम वीडियो ब्राउजर टैब शेयर करता है और रूम में सभी इसे रियल-टाइम में देखते हैं। केवल होस्ट को सब्सक्रिप्शन की जरूरत है। स्क्रीनशेयर क्रोम ब्राउजर में सबसे अच्छा काम करता है।",
      "homeFaqQ4": "वॉच पार्टी के दौरान इंटरनेट कट जाए तो क्या होगा?",
      "homeFaqA4": "SahaPlay स्वचालित रूप से आपको रूम से दोबारा जोड़ने की कोशिश करता है। एक बार ऑनलाइन होने पर, यह आपको ठीक उसी जगह ले जाता है जहां वीडियो चल रहा है — ताकि आप कुछ न चूकें। आपका चैट हिस्ट्री भी स्वचालित रूप से रीलोड होता है।",
      "roomCover": "रूम कवर",
      "chatLock": "चैट लॉक",
      "chatLockDesc": "एंड-टू-एंड एन्क्रिप्टेड चैट। सत्र-केवल कुंजी सामग्री। सच्ची गोपनीयता।",
      "screenShare": "स्क्रीन शेयर",
      "screenShareDesc": "P2P WebRTC कनेक्शन के माध्यम से सीधे अपनी स्क्रीन साझा करें।",
      "voiceVideo": "वॉयस और वीडियो",
      "voiceVideoDesc": "100ms से कम विलंबता के साथ क्रिस्टल-क्लियर P2P ऑडियो और वीडियो।",
      "cookiePageBadge": "Security & Storage",
      "cookiePolicyTitle": "Cookie Policy",
      "cookieHeroDesc": "Learn how SahaPlay uses cookies, browser storage, authentication technologies, and security mechanisms to provide a secure and personalized experience.",
      "cookieLastUpdated": "Last Updated: May 2026",
      "cookieWhatTitle": "What are Cookies?",
      "cookieWhatDesc": "Cookies are small pieces of data stored in your browser that help websites remember information between visits. SahaPlay uses cookies and similar browser technologies to support authentication, security, preferences, and application performance.",
      "cookieHowTitle": "How SahaPlay Uses Cookies",
      "cookieHowDesc": "We use cookies and browser storage technologies to enable essential core features.",
      "cookieAuthTitle": "Authentication",
      "cookieAuthItem1": "Keeps users signed in securely.",
      "cookieAuthItem2": "Maintains active sessions.",
      "cookieAuthItem3": "Reduces unnecessary logins.",
      "cookieSecurityTitle": "Security",
      "cookieSecurityItem1": "Protects accounts and sessions.",
      "cookieSecurityItem2": "Supports security verification.",
      "cookieSecurityItem3": "Helps prevent unauthorized access.",
      "cookiePrefsTitle": "Preferences",
      "cookiePrefsItem1": "Remembers theme settings (dark/light mode).",
      "cookiePrefsItem2": "Remembers interface preferences.",
      "cookiePrefsItem3": "Stores user customization choices.",
      "cookiePerfTitle": "Performance",
