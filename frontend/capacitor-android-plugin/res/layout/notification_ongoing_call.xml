<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom content view for the ongoing-call notification (see
  SahaplayCallService.buildNotification()). Same reasoning as
  notification_incoming_call.xml: a plain addAction() end-call button can't
  be made full-width, PILL-shaped, or explicitly colored, so this is a real
  layout instead — RemoteViews can only inflate from a real layout resource,
  not a programmatic view tree.

  Hardcoded dark background + colors (not ?android:attr/textColor*) for the
  same reason notification_incoming_call.xml switched to it — confirmed
  on-device that the system attr reads as barely-visible dark-on-dark on at
  least one real OEM skin. Call UI is permanently dark by design regardless
  of the phone's own theme anyway.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#14171F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ongoing_call_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ongoing_call_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Static status text while ringing/dialing (no elapsed time
                 yet) — hidden and swapped for the Chronometer once answered. -->
            <TextView
                android:id="@+id/ongoing_call_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:visibility="gone" />

            <Chronometer
                android:id="@+id/ongoing_call_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#9CA3AF"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_end_call"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/pill_red"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_end_call_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hang Up"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
