<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom content view for the ongoing-call notification (see
  SahaplayCallService.buildNotification()). Same reasoning as
  notification_incoming_call.xml: a plain addAction() end-call button can't
  be made full-width or explicitly colored, so this is a real layout with a
  full-width red End Call button instead — RemoteViews can only inflate from
  a real layout resource, not a programmatic view tree.

  No hardcoded background here (was a dark navy panel) — same "box inside a
  box" problem as the incoming-call notification had; this sits flush in the
  system's own notification card instead, with theme-adaptive text colors.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ongoing_call_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Static status text while ringing/dialing (no elapsed time yet) —
             hidden and swapped for the Chronometer once the call is answered. -->
        <TextView
            android:id="@+id/ongoing_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <Chronometer
            android:id="@+id/ongoing_call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_end_call"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="#EF4444"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:text="End call"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
