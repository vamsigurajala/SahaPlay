<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom notification content view for the incoming-call notification (see
  IncomingCallActivity.showIncomingCall()). Plain NotificationCompat.Builder
  .addAction() renders Decline/Answer as small system-styled chip buttons
  with no control over size, width, or color (confirmed on-device) — this
  RemoteViews layout replaces that row with two full-width, evenly-split
  PILL-shaped buttons instead (see res/drawable/pill_red.xml / pill_green.xml),
  the same shape WhatsApp's own call notification uses.

  A PREVIOUS version of this left the background transparent and used
  ?android:attr/textColor* so it would follow the system's own light/dark
  notification card — confirmed on-device that this reads as barely-visible
  dark-grey-on-dark-grey on at least one real OEM skin (the system attr
  wasn't resolving to a genuinely readable color there). Call UI is
  permanently dark by design in this app regardless of the phone's own
  theme anyway (see OneOnOneCallScreen.jsx's matching reasoning for the
  in-app call screen) — hardcoding this card's own background and text
  colors instead guarantees contrast on every device, and fills the ENTIRE
  custom content area edge-to-edge (no DecoratedCustomViewStyle header
  above it — see showIncomingCall()) so there's no second, differently-
  colored panel visible anywhere in the notification.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#14171F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/call_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/call_caller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/call_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#9CA3AF"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_decline"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pill_red"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Decline"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_answer"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/pill_green"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Answer"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
