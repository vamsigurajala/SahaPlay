<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom notification content view for the incoming-call notification (see
  IncomingCallActivity.showIncomingCall()). Plain NotificationCompat.Builder
  .addAction() renders Decline/Answer as small system-styled chip buttons
  with no control over size, width, or color (confirmed on-device) — this
  RemoteViews layout replaces that row with two full-width, evenly-split,
  explicitly red/green buttons instead, the same way WhatsApp's own call
  notification looks. RemoteViews can only inflate from a real layout
  resource (no fully-programmatic RemoteViews construction exists, unlike
  a normal Activity view tree), so this is the one native UI piece in this
  plugin that has to be a real XML file rather than code — kept as small
  and static as this file's other "no XML" pieces would allow.

  No background here (was a hardcoded dark navy panel) — that painted a
  second, differently-colored box floating inside the system notification's
  own card, reading as "a box inside a box." Leaving it transparent lets this
  content sit flush in the same card the system already draws (matching
  every other Android notification, including this app's own chat/message
  ones), light or dark, so title/name use ?attr/textColor* system references
  instead of hardcoded white — hardcoded white text would've gone invisible
  the moment the system card itself is light (light system theme).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/call_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/call_caller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_decline"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="#EF4444"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="Decline"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_answer"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="#22C55E"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="Answer"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
