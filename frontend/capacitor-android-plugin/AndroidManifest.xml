<?xml version="1.0" encoding="utf-8"?>
<!--
  Overwrites the file `npx cap add android` generates, same "replace the
  whole known-small file outright" approach used for MainActivity.java —
  content below is the confirmed real generated manifest (verified by
  running `cap add android` locally, no Android SDK required) with camera/
  mic permissions added.

  Without CAMERA / RECORD_AUDIO / MODIFY_AUDIO_SETTINGS declared here,
  Capacitor's WebView permission bridge (BridgeWebChromeClient.
  onPermissionRequest, in @capacitor/android) still fires when the web app
  calls getUserMedia() for video calls, but Android silently auto-denies any
  runtime permission request for a permission the manifest never declared —
  the system permission dialog never even appears, which is exactly the
  "Camera access denied" toast the app showed with no prompt.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google Sign-In can't run inside our own WebView at all — Google
                 deliberately blocks its OAuth screen for any embedded-webview
                 user agent (anti-phishing policy), which is why the button did
                 nothing. The fix opens the OAuth flow in a real Chrome Custom
                 Tab (Google allows that) via @capacitor/browser, pointed at
                 https://sahaplay.com/auth/google/callback (a real page on our
                 own domain, since Google's web OAuth client type requires an
                 https redirect_uri, not a custom scheme, for the first hop).
                 That page immediately redirects to sahaplay://auth-callback
                 with the id_token, which THIS intent-filter catches, handing
                 control back to the already-running app (singleTask above)
                 instead of launching a second instance. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sahaplay" android:host="auth-callback" />
            </intent-filter>

            <!-- IncomingCallActivity's "Answer" button (and its notification
                 action) hand off here — accepting a call needs real
                 getUserMedia/RTCPeerConnection, which only exists in the
                 WebView/JS layer. See nativeCallBridge.js, which listens for
                 this exact deep link. Same singleTask-reuse benefit as the
                 Google auth callback above: a cold-started app answers into
                 the same instance an already-running one would. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sahaplay" android:host="call-answer" />
            </intent-filter>

        </activity>

        <!-- Full-screen, lock-screen-visible incoming call UI (see
             IncomingCallActivity.java). singleInstance: this is a standalone
             screen, not meant to share a back stack with MainActivity — a
             second incoming call while one is already showing just updates
             the same instance rather than stacking. excludeFromRecents: a
             transient ringing screen has no business lingering in the
             recent-apps switcher after being dismissed. -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:theme="@style/AppTheme.NoActionBarLaunch" />

        <!-- Removes Capacitor's own FCM service registration (declared in its
             bundled AAR manifest) so SahaplayFirebaseMessagingService below is
             the ONLY thing registered for MESSAGING_EVENT — Android only ever
             delivers to one FirebaseMessagingService; having both left in
             would make delivery ambiguous. SahaplayFirebaseMessagingService
             extends Capacitor's own class and calls super.onMessageReceived()
             first, so nothing existing (chat/friend-request pushes, FCM token
             registration) is lost by this removal. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <service
            android:name=".SahaplayFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Screen share (see SahaplayScreenCaptureService.java): Android
             requires MediaProjection capture to run inside a declared,
             running foreground service (not just an Activity) on API 29+,
             or captured frames come back blank. foregroundServiceType
             "mediaProjection" is what lets startForeground() legally cover
             a MediaProjection capture on API 29+, and is mandatory to
             declare (alongside the FOREGROUND_SERVICE_MEDIA_PROJECTION
             permission below) on API 34+. -->
        <service
            android:name=".SahaplayScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 13+ requires this runtime permission before ANY notification
         (not just push) can be shown — @capacitor/push-notifications likely
         already declares this in its own bundled manifest, but declaring it
         here too removes any doubt rather than relying on that unverified. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the incoming-call notification actually launch
         IncomingCallActivity full-screen over a locked screen — without this,
         Android 14+ silently downgrades it to a plain heads-up notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Not required so the app still installs on devices lacking a camera/mic. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
