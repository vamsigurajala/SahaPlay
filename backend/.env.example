# ─── Required — server will not start without these ───────────────────────────

# Port to listen on (Render sets this automatically;
# leave unset for local dev to use default 3001)
PORT=

# Node environment (development | production | test)
NODE_ENV=production

# Public URL of the frontend (used in email links — no trailing slash)
# Accepts a comma-separated list for multi-domain CORS (e.g. apex + www)
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string (Supabase → Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# JWT signing secret — generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Supabase project URL and service-role key (Supabase → Settings → API)
# IMPORTANT: service-role key bypasses RLS — keep it server-side only, never expose to frontend
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Required for email features (Resend) ─────────────────────────────────────

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Transactional sender (must match verified Resend domain)
APP_EMAIL_FROM=SahaPlay <no-reply@sahaplay.com>
APP_EMAIL_NO_REPLY=no-reply@sahaplay.com
APP_EMAIL_CONTACT=contact@sahaplay.com
APP_EMAIL_SAFETY=safety@sahaplay.com
APP_EMAIL_REPORT=report@sahaplay.com
APP_EMAIL_FOUNDERS=founders@sahaplay.com

# ─── Legacy Gmail (kept for reference — no longer used) ───────────────────────
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# NOTE: Admin role is currently set manually via direct DB
# update, not auto-bootstrapped from this email on first login.
# This variable is not read by the application.
ADMIN_EMAIL=

# ─── Required for Google Sign-In ──────────────────────────────────────────────

GOOGLE_CLIENT_ID=

# ─── Required for Apple Sign-In ────────────────────────────────────────────────

# Apple Services ID (Apple Developer → Certificates, Identifiers & Profiles →
# Identifiers → Services IDs). This is the only Apple credential the backend needs —
# it's the audience the identity token is verified against. A Team ID/Key ID/.p8
# private key would only be needed for server-to-server token exchange or revocation,
# which this app doesn't do.
APPLE_CLIENT_ID=

# ─── Optional — encryption ────────────────────────────────────────────────────

# Symmetric key for server-side chat encryption helpers.
# Must be set explicitly and must NEVER change after first use — changing it
# renders all existing encv1: ciphertext in the DB permanently undecryptable
# without a decryption-and-re-encryption migration.
# Falls back to JWT_SECRET only until first deployment.
CHAT_ENCRYPTION_SECRET=generate-with-crypto-randombytes-32-hex-never-change-after-set

# ─── Optional — third-party integrations ──────────────────────────────────────

# Twitch API (for Twitch stream search)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Vimeo API
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=

# Hyperbeam (for co-browsing rooms)
HYPERBEAM_API_KEY=

# Metered.ca TURN relay (for camera/screen-share WebRTC across different networks)
# https://sahaplay.metered.live/api/v1/turn/credentials?apiKey=... — used by
# GET /api/turn-credentials. Server-side only, never sent to the frontend.
METERED_API_KEY=

# Web Push (VAPID) — browser/desktop push notifications (calls, chat) for
# users who haven't installed the native app. Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# and never change afterward — changing the keypair invalidates every
# existing browser subscription (frontend re-subscribes automatically next
# time the page loads, but users lose push delivery in the gap).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact shown to push services if they need to reach the app owner about
# abuse/errors — any mailto: or https: URL works.
VAPID_SUBJECT=mailto:contact@sahaplay.com

# ─── Legacy SMTP (kept for reference — no longer used) ────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ─── Optional — error monitoring ───────────────────────────────────────────────

# Sentry DSN — leave unset to disable Sentry entirely (silent no-op in local dev)
SENTRY_DSN=https://your-key@sentry.io/project-id
